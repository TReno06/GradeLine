{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GradeLine",
  "version": "1.0.0",
  "identifier": "com.treno06.gradeline",
  "build": {
    "frontendDist": "../../app/dist",
    "beforeBuildCommand": "npm --prefix ../app run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GradeLine",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Survey DXF to TIN surface, long section and driveway checks",
    "fileAssociations": [
      {
        "ext": ["gradeline"],
        "name": "GradeLine job",
        "description": "GradeLine job file",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
